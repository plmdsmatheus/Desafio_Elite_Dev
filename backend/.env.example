# Django
DJANGO_SECRET_KEY=change-me-to-a-random-secret-in-your-local-.env
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# - Rodando o backend DENTRO do Docker Compose: o serviço "backend" já sobrescreve essa
#   variável para apontar para "db:5432" (ver docker-compose.yml), não precisa mexer aqui.
# - Rodando o backend FORA do Docker (poetry run ...) contra o Postgres do Compose: use
#   localhost:5433 (porta publicada pelo host para não colidir com um Postgres local em 5432).
DATABASE_URL=postgres://postgres:postgres@localhost:5433/eventos_db

# Frontend origin allowed to call the API (dev server)
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173

# External catalog APIs — get free keys at:
# https://developer.ticketmaster.com/products-and-docs/apis/getting-started/
# https://developer.themoviedb.org/docs/getting-started
TICKETMASTER_API_KEY=
TMDB_API_KEY=
TMDB_API_READ_ACCESS_TOKEN=
